# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
*.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# nl2sql experiment output
nl2sql-eval-*
reread-backups/
reread-reports/
reread-cache/
health-reports/
health-cache/

# Windows download markers
*Zone.Identifier

# local output of test tools
circular-battery-report.txt

# large originals and OCR language data stay outside git (the curated Holidays/*.json files DO stay)
*.traineddata
/Holidays/**/*.pdf

# acceptance-harness output: holds answers from the live directory, never commit
eval/results/
