{"id":"src/app/api/live/status/route.ts","pkg":"src/app/api","kind":"route","lines":66,"commentLines":7,"header":["Are the live sources answering? This is one page that asks the live routes (gold, fuel, news, sports, markets, the weather, the airport flights, the trains at Durgapur station, and the two history charts) and says, for each, whether its source answered, how long it took and what it said if it did not. It is the place to look first after a deployment, because a source can answer on one host and refuse on another (some sites turn away the addresses of cloud servers). I read nothing from the caller."],"symbols":[{"name":"dynamic","kind":"constant","exported":true,"line":20,"sig":"const dynamic = \"force-dynamic\"","type":"","doc":[],"members":[],"items":0,"id":"89113de694-dynamic","usedBy":[]},{"name":"maxDuration","kind":"constant","exported":true,"line":21,"sig":"const maxDuration = 60","type":"","doc":[],"members":[],"items":0,"id":"89113de694-maxDuration","usedBy":[]},{"name":"Check","kind":"interface","exported":false,"line":23,"generics":"","extends":"","doc":[],"members":[{"kind":"field","name":"name","line":24,"type":"string","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"ok","line":25,"type":"boolean","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"ms","line":26,"type":"number","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"stale","line":27,"type":"boolean","optional":true,"readonly":false,"doc":[]},{"kind":"field","name":"detail","line":28,"type":"string","optional":false,"readonly":false,"doc":[]}],"id":"89113de694-Check","usedBy":[]},{"name":"check","kind":"function","exported":false,"isDefault":false,"async":true,"line":31,"sig":"async function check(name: string, run: () => Promise<Response>): Promise<Check>","params":[{"name":"name","type":"string","optional":false,"rest":false,"def":""},{"name":"run","type":"() => Promise<Response>","optional":false,"rest":false,"def":""}],"retur