{"id":"src/app/api/account/password/otp/route.ts","pkg":"src/app/api","kind":"route","lines":47,"commentLines":5,"header":["POST /api/account/password/otp sends the signed-in person a one-time code for a password change, to his own mobile number (else e-mail) on record. I made the request name no destination, so it cannot be pointed at anybody else. It is built but switched off: it answers 404 until PASSWORD_OTP=on on the host, and says plainly that no gateway is set up until one is (src/lib/security/otpSender.ts). The rules (6 digits, 5 minutes, 5 tries, 60 seconds between codes, 3 an hour) are kept in src/lib/security/otp.ts."],"symbols":[{"name":"dynamic","kind":"constant","exported":true,"line":18,"sig":"const dynamic = \"force-dynamic\"","type":"","doc":[],"members":[],"items":0,"id":"25c2c49dda-dynamic","usedBy":[]},{"name":"fetchCache","kind":"constant","exported":true,"line":19,"sig":"const fetchCache = \"force-no-store\"","type":"","doc":[],"members":[],"items":0,"id":"25c2c49dda-fetchCache","usedBy":[]},{"name":"pace","kind":"constant","exported":false,"line":21,"sig":"const pace = createLimiter({ max: 6, windowMs: 60_000 })","type":"","doc":[],"members":[],"items":0,"id":"25c2c49dda-pace","usedBy":[]},{"name":"NO_STORE","kind":"constant","exported":false,"line":22,"sig":"const NO_STORE = { \"Cache-Control\": \"no-store\" }","type":"","doc":[],"members":[{"kind":"key","name":"\"Cache-Control\"","line":22,"value":"\"no-store\"","doc":[]}],"items":0,"id":"25c2c49dda-NO_STORE","usedBy":[]},{"name":"fail","kind":"function","exported":false,"line":23,"async":false,"sig":"const fail = (status: number, error: string, code: string, extra: Record<string, unknown> = {}, headers: Record<string, string> = NO_STORE) =>","params":[{"name":"status","type":"number","optional":false,"rest":false,"def":""},{"name":"error","type":"string","optional":false,"rest":false,"def":""},{"name":"code","type":"string","optional":false,"rest":false,"def":""},{"name":"extra","type":"Rec