{"id":"src/app/api/account/password/route.ts","pkg":"src/app/api","kind":"route","lines":108,"commentLines":11,"header":["GET /api/account/password what the \"Change password\" window asks first: may this person change it here, has it run out (180 days: the window then comes up by itself), how long the current one lasts, and whether a one-time code is needed (switched off for now) POST /api/account/password { current, next, otp? } the signed-in person changes his own password. The rules for it are in src/lib/security/changePassword.ts. Who is asking is the sign-in's ticket only. I made sure the route changes nobody else's password."],"symbols":[{"name":"dynamic","kind":"constant","exported":true,"line":21,"sig":"const dynamic = \"force-dynamic\"","type":"","doc":[],"members":[],"items":0,"id":"3bdd5f7a57-dynamic","usedBy":[]},{"name":"fetchCache","kind":"constant","exported":true,"line":22,"sig":"const fetchCache = \"force-no-store\"","type":"","doc":[],"members":[],"items":0,"id":"3bdd5f7a57-fetchCache","usedBy":[]},{"name":"lock","kind":"constant","exported":false,"line":25,"sig":"const lock = createFailureLock({ max: 5, windowMs: 15 * 60_000 })","type":"","doc":["I lock this ticket's password changes for a while after five wrong current passwords in 15 minutes, and allow at most 10 requests a minute per ticket (see src/lib/security/rateLimit.ts for what a limit in one server copy can do)."],"members":[],"items":0,"id":"3bdd5f7a57-lock","usedBy":[]},{"name":"pace","kind":"constant","exported":false,"line":26,"sig":"const pace = createLimiter({ max: 10, windowMs: 60_000 })","type":"","doc":[],"members":[],"items":0,"id":"3bdd5f7a57-pace","usedBy":[]},{"name":"NO_STORE","kind":"constant","exported":false,"line":27,"sig":"const NO_STORE = { \"Cache-Control\": \"no-store\" }","type":"","doc":[],"members":[{"kind":"key","name":"\"Cache-Control\"","line":27,"value":"\"no-store\"","doc":[]}],"items":0,"id":"3bdd5f7a57-NO_STORE","usedBy":[]},{"name":"off","kind":"function