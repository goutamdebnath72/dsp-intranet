{"id":"src/components/managementPanels.ts","pkg":"src/components","kind":"module","lines":38,"commentLines":8,"header":["The management pages and the written-summary view, loaded on first need. They are drawn only for a signed-in manager (or an executive's deep answer) and carry the heavy parts of the app (the rich-text editor, the chart library, the upload form), so I keep them out of the search window: each is fetched the first time it is shown. The list lives here ONCE: the search window draws these components, and calls preloadManagementPanels() the moment a manager is about to need them (the pointer on the Admin button, the hub on screen), so the page they open is there without a wait. To add a management page, add one line in PANELS."],"symbols":[{"name":"loadPax","kind":"function","exported":false,"line":9,"async":false,"sig":"const loadPax = () =>","params":[],"returns":"","doc":[],"paramDocs":{},"returnDoc":"","id":"f9d46a0bc1-loadPax","usedBy":[]},{"name":"loadEmployee","kind":"function","exported":false,"line":10,"async":false,"sig":"const loadEmployee = () =>","params":[],"returns":"","doc":[],"paramDocs":{},"returnDoc":"","id":"f9d46a0bc1-loadEmployee","usedBy":[]},{"name":"loadHoliday","kind":"function","exported":false,"line":11,"async":false,"sig":"const loadHoliday = () =>","params":[],"returns":"","doc":[],"paramDocs":{},"returnDoc":"","id":"f9d46a0bc1-loadHoliday","usedBy":[]},{"name":"loadCircular","kind":"function","exported":false,"line":12,"async":false,"sig":"const loadCircular = () =>","params":[],"returns":"","doc":[],"paramDocs":{},"returnDoc":"","id":"f9d46a0bc1-loadCircular","usedBy":[]},{"name":"loadAnnouncement","kind":"function","exported":false,"line":13,"async":false,"sig":"const loadAnnouncement = () =>","params":[],"returns":"","doc":[],"paramDocs":{},"returnDoc":"","id":"f9d46a0bc1-loadAnnouncement","usedBy":[]},{"name":"loadAccessLog","kind":"function","exported":false,"line":14,"async":false,"sig":"const loadAccessLog = () =>",