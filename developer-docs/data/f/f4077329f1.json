{"id":"scripts/check-manual-marks.ts","pkg":"scripts","kind":"script","lines":52,"commentLines":7,"header":["For every quote the DSP history card takes from a PDF it opens in its own viewer (the two JO Manuals, SAIL's Steel Cities book, the annual reports, the Lok Sabha replies, the obituary), I check: is it on the PDF page that the card's page link opens, and does the viewer's highlight (src/tools/dsphistory/highlight.ts, on pdf.js's reading of the page) find it there? Run from the project root: npx tsx --tsconfig tsconfig.selftest.json scripts/check-manual-marks.ts [folder] (the folder holds the JO Manuals, default ~/Downloads/jo; the published PDFs are downloaded once into the system's temp folder) Last run: every quote marked on its page, none outside the page."],"symbols":[{"name":"folder","kind":"constant","exported":false,"line":15,"sig":"const folder = process.argv[2] ?? `${process.env.HOME}/Downloads/jo`","type":"","doc":[],"members":[],"items":0,"id":"f4077329f1-folder","usedBy":[]},{"name":"cache","kind":"constant","exported":false,"line":16,"sig":"const cache = `${tmpdir()}/history-docs-check`","type":"","doc":[],"members":[],"items":0,"id":"f4077329f1-cache","usedBy":[]},{"name":"docs","kind":"constant","exported":false,"line":19,"sig":"const docs: Record<string, any> = {}","type":"Record<string, any>","doc":[],"members":[],"items":0,"id":"f4077329f1-docs","usedBy":[]},{"name":"bytesOf","kind":"function","exported":false,"isDefault":false,"async":true,"line":20,"sig":"async function bytesOf(id: string): Promise<Uint8Array>","params":[{"name":"id","type":"string","optional":false,"rest":false,"def":""}],"returns":"Promise<Uint8Array>","generics":"","doc":[],"paramDocs":{},"returnDoc":"","id":"f4077329f1-bytesOf","usedBy":[]},{"name":"pieces","kind":"function","exported":false,"isDefault":false,"async":true,"line":27,"sig":"async function pieces(id: string, n: number)","params":[{"name":"id","type":"string","optional":false,"rest":false,"def":""},{"name":