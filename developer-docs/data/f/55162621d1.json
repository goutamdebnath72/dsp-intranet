{"id":"scripts/lib/acceptance-core.mjs","pkg":"scripts/lib","kind":"script","lines":646,"commentLines":59,"header":["This is the PURE part of the omnibar acceptance harness: no network, no files. Everything here is unit-tested by scripts/omnibar-acceptance.selftest.mjs, so I can trust the judge before it judges the app. What it does, for one question and the JSON the real /api/ai-search returned:","1. inferRoute() -- which channel answered (the API does not say, so it is read from the shape of the answer)","2. judge() -- compares route + facts (+ the circular battery's rules) with the record's expectations","3. labels a failure the way HANDOFF_dsp-intranet_front-path.md asks: ROUTE (wrong channel) or ENGINE (right channel, wrong content). DISPLAY cannot be judged by a script: it stays for human eyes."],"symbols":[{"name":"norm","kind":"function","exported":true,"line":13,"async":false,"sig":"const norm = (s) =>","params":[{"name":"s","type":"","optional":false,"rest":false,"def":""}],"returns":"","doc":["---------------------------------------------------------------------------------------------- text helpers"],"paramDocs":{},"returnDoc":"","id":"55162621d1-norm","usedBy":[]},{"name":"padded","kind":"function","exported":false,"line":14,"async":false,"sig":"const padded = (s) =>","params":[{"name":"s","type":"","optional":false,"rest":false,"def":""}],"returns":"","doc":[],"paramDocs":{},"returnDoc":"","id":"55162621d1-padded","usedBy":[]},{"name":"SKIP_KEYS","kind":"constant","exported":false,"line":17,"sig":"const SKIP_KEYS = new Set([\"sql\", \"display\", \"logId\", \"userKey\", \"confidence\", \"sailPNo\", \"mobileMasked\", \"emailMasked\"])","type":"","doc":["These keys are never searched and never written to a result file."],"members":[],"items":0,"id":"55162621d1-SKIP_KEYS","usedBy":[]},{"name":"flattenText","kind":"function","exported":true,"isDefault":false,"async":false,"line":20,"sig":"export function flattenText(node)","params":[{"name":"node","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["Returns every string / number in the answer as one normalised, searchable text."],"paramDocs":{},"returnDoc":"","id":"55162621d1-flattenText","usedBy":[]},{"name":"hasFact","kind":"function","exported":true,"isDefault":false,"async":false,"line":34,"sig":"export function hasFact(hay, fact)","params":[{"name":"hay","type":"","optional":false,"rest":false,"def":""},{"name":"fact","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["A fact is a string (it must appear as whole words) or an array of alternatives (any one is enough)."],"paramDocs":{},"returnDoc":"","id":"55162621d1-hasFact","usedBy":[]},{"name":"sanitize","kind":"function","exported":true,"isDefault":false,"async":false,"line":43,"sig":"export function sanitize(node)","params":[{"name":"node","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["Returns the answer with everything personal removed, for files written to disk."],"paramDocs":{},"returnDoc":"","id":"55162621d1-sanitize","usedBy":["scripts/omnibar-acceptance.mjs"]},{"name":"containsSailPNo","kind":"function","exported":true,"isDefault":false,"async":false,"line":57,"sig":"export function containsSailPNo(node)","params":[{"name":"node","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["True when the answer carries a person's SAIL P.No., which is also the login password (security audit #1)."],"paramDocs":{},"returnDoc":"","id":"55162621d1-containsSailPNo","usedBy":[]},{"name":"extractRows","kind":"function","exported":true,"isDefault":false,"async":false,"line":67,"sig":"export function extractRows(payload)","params":[{"name":"payload","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["---------------------------------------------------------------------------------------------- rows","Returns every \"row\" the answer shows (table row, person, holiday, quota, circular...) as a list of normalised cells."],"paramDocs":{},"returnDoc":"","id":"55162621d1-extractRows","usedBy":[]},{"name":"cellMatches","kind":"function","exported":false,"isDefault":false,"async":false,"line":93,"sig":"function cellMatches(cell, tokenNorm)","params":[{"name":"cell","type":"","optional":false,"rest":false,"def":""},{"name":"tokenNorm","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":[],"paramDocs":{},"returnDoc":"","id":"55162621d1-cellMatches","usedBy":[]},{"name":"rowHasMatch","kind":"function","exported":true,"isDefault":false,"async":false,"line":99,"sig":"export function rowHasMatch(rows, tokens)","params":[{"name":"rows","type":"","optional":false,"rest":false,"def":""},{"name":"tokens","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["`rowHas` is a list of rows; each row is a list of tokens (a string, or an array of alternatives) that must all appear in ONE row."],"paramDocs":{},"returnDoc":"","id":"55162621d1-rowHasMatch","usedBy":[]},{"name":"measureCount","kind":"function","exported":true,"isDefault":false,"async":false,"line":109,"sig":"export function measureCount(payload, of)","params":[{"name":"payload","type":"","optional":false,"rest":false,"def":""},{"name":"of","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["Returns the number the answer reports, measured the way the record says (`of`). null means the answer has no such number."],"paramDocs":{},"returnDoc":"","id":"55162621d1-measureCount","usedBy":[]},{"name":"inferRoute","kind":"function","exported":true,"isDefault":false,"async":false,"line":140,"sig":"export function inferRoute(payload)","params":[{"name":"payload","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["---------------------------------------------------------------------------------------------- route","Which channel answered. The API does not say, so I read it from the answer: array -> CIRCULAR (or POLICY when the first hit is a holiday-policy note; NONE when empty) {synthesis} -> EDS {analytics} -> BAD-QUERY (kind error) | HOLIDAY | HEALTH-SQL / EMP-SQL (model SQL, legacy engine) | CLARIFY"],"paramDocs":{},"returnDoc":"","id":"55162621d1-inferRoute","usedBy":[]},{"name":"routeMatches","kind":"function","exported":true,"isDefault":false,"async":false,"line":166,"sig":"export function routeMatches(expected, actual)","params":[{"name":"expected","type":"","optional":false,"rest":false,"def":""},{"name":"actual","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["`expected` is one route, a list of acceptable routes, or \"ANY\". I treat NOT-FOUND as satisfied by an empty list or a clarify/\"cannot answer\" card."],"paramDocs":{},"returnDoc":"","id":"55162621d1-routeMatches","usedBy":[]},{"name":"evaluateCircular","kind":"function","exported":true,"isDefault":false,"async":false,"line":174,"sig":"export function evaluateCircular(c, payload)","params":[{"name":"c","type":"","optional":false,"rest":false,"def":""},{"name":"payload","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["---------------------------------------------------------------------------------------------- the circular battery's rules","Ported from scripts/circular-battery.mjs (evaluate()), so the verified circular cases keep their exact meaning."],"paramDocs":{},"returnDoc":"","id":"55162621d1-evaluateCircular","usedBy":[]},{"name":"parseTraceHeaders","kind":"function","exported":true,"isDefault":false,"async":false,"line":220,"sig":"export function parseTraceHeaders(headers)","params":[{"name":"headers","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["---------------------------------------------------------------------------------------------- the server's own trace","Since step 23a the route names itself in response headers (src/lib/search/frontPathTrace.ts): which route answered, how many model calls and tokens it used, and how long each stage took. `headers` = a plain object with LOWER-CASE keys. Returns null for a server that does not send them (an older build); the harness then falls back to inferring."],"paramDocs":{},"returnDoc":"","id":"55162621d1-parseTraceHeaders","usedBy":[]},{"name":"routesAgree","kind":"function","exported":true,"isDefault":false,"async":false,"line":247,"sig":"export function routesAgree(serverRoute, serverKind, inferred)","params":[{"name":"serverRoute","type":"","optional":false,"rest":false,"def":""},{"name":"serverKind","type":"","optional":false,"rest":false,"def":""},{"name":"inferred","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["Does the route the harness INFERRED agree with the route the server says it took? I use this as a check on the inference itself."],"paramDocs":{},"returnDoc":"","id":"55162621d1-routesAgree","usedBy":[]},{"name":"DAILY_LIMIT","kind":"constant","exported":true,"line":262,"sig":"const DAILY_LIMIT = /free daily allowance .{0,120}is used up/i","type":"","doc":["---------------------------------------------------------------------------------------------- the judge"],"members":[],"items":0,"id":"55162621d1-DAILY_LIMIT","usedBy":[]},{"name":"judge","kind":"function","exported":true,"isDefault":false,"async":false,"line":268,"sig":"export function judge(rec, resp)","params":[{"name":"rec","type":"","optional":false,"rest":false,"def":""},{"name":"resp","type":"","optional":false,"rest":false,"def":""}],"returns":"","generics":"","doc":["resp = { status, json, text, ms, error } -> the result record written to the report. outcome is one of: PASS | FAIL | ERROR | OBSERVED (pending decision / no expectation yet) | INFO"],"paramDocs":{},"returnDoc":"","id":"55162621d1-judge","usedBy":["scripts/omnibar-acceptance.mjs"]},{"name":"percentile","kind":"function","exported":true,"isDefault":false,"async":false,"lin