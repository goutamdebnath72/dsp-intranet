{"id":"src/app/api/live/cpi/route.ts","pkg":"src/app/api","kind":"route","lines":24,"commentLines":5,"header":["The Consumer Price Index and inflation of MoSPI: the index of each month for all India (Combined, Urban, Rural) and for each State, and the inflation rate month by month since 2016 (src/lib/live/cpi.ts). I read from the saved rows (public.cpi_month) and ask MoSPI only for a month not saved yet (src/lib/live/cpiService.ts). Nothing is read from the caller. The index changes once a month, so I keep an answer for three hours."],"symbols":[{"name":"dynamic","kind":"constant","exported":true,"line":12,"sig":"const dynamic = \"force-dynamic\"","type":"","doc":[],"members":[],"items":0,"id":"40283e86d0-dynamic","usedBy":[]},{"name":"maxDuration","kind":"constant","exported":true,"line":13,"sig":"const maxDuration = 25","type":"","doc":[],"members":[],"items":0,"id":"40283e86d0-maxDuration","usedBy":[]},{"name":"GET","kind":"route","exported":true,"isDefault":false,"async":true,"line":15,"sig":"export async function GET()","params":[],"returns":"","generics":"","doc":[],"paramDocs":{},"returnDoc":"","id":"40283e86d0-GET","usedBy":[]}],"imports":[{"file":"src/lib/db/index.ts","names":["getDb"],"lazy":false},{"file":"src/lib/live/cpi.ts","names":["MOSPI_SITE","Cpi"],"lazy":false},{"file":"src/lib/live/cpiService.ts","names":["cpiAnswer"],"lazy":false},{"file":"src/lib/live/cpiStore.ts","names":["cpiStoreFor"],"lazy":false},{"file":"src/lib/live/envelope.ts","names":["liveRoute"],"lazy":false}],"importedBy":[],"external":[],"reexports":[],"tests":[],"behaviours":[]}