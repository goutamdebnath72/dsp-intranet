{"id":"src/app/api/tools/intent/route.ts","pkg":"src/app/api","kind":"route","lines":40,"commentLines":5,"header":["Which utility does this line mean? (POST {\"line\": \"...\"} -> {ok, id|null, confidence}). The search box calls this only for a whole sentence that no utility's words settle, after Enter. I send the one line (long digit runs and e-mail addresses blanked, never an ID query) and the list of utilities to the AI (Gemini), and give back only a utility id that is really in the list. Nothing is stored. Only a signed-in user may ask; a person can ask at most 12 times a minute; the same line is answered from memory for an hour. TOOL_INTENT_AI=off switches it off (the box then simply searches)."],"symbols":[{"name":"dynamic","kind":"constant","exported":true,"line":12,"sig":"const dynamic = \"force-dynamic\"","type":"","doc":[],"members":[],"items":0,"id":"7d6c055e68-dynamic","usedBy":[]},{"name":"maxDuration","kind":"constant","exported":true,"line":13,"sig":"const maxDuration = 20","type":"","doc":[],"members":[],"items":0,"id":"7d6c055e68-maxDuration","usedBy":[]},{"name":"none","kind":"function","exported":false,"line":15,"async":false,"sig":"const none = (extra: object = {}) =>","params":[{"name":"extra","type":"object","optional":true,"rest":false,"def":"{}"}],"returns":"","doc":[],"paramDocs":{},"returnDoc":"","id":"7d6c055e68-none","usedBy":[]},{"name":"kept","kind":"constant","exported":false,"line":17,"sig":"const kept = new Map<string, { at: number; id: string | null; confidence: number }>()","type":"","doc":[],"members":[],"items":0,"id":"7d6c055e68-kept","usedBy":[]},{"name":"asked","kind":"constant","exported":false,"line":18,"sig":"const asked = new Map<string, number[]>()","type":"","doc":[],"members":[],"items":0,"id":"7d6c055e68-asked","usedBy":[]},{"name":"HOUR","kind":"constant","exported":false,"line":19,"sig":"const HOUR = 60 * 60 * 1000","type":"","doc":[],"members":[],"items":0,"id":"7d6c055e68-HOUR","usedBy":[]},{"name":"POST","kind":"r