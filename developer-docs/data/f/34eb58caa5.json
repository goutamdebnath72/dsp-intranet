\"with\", \"that\", \" …","type":"","doc":[],"members":[],"items":0,"id":"34eb58caa5-QUESTION_STOP","usedBy":[]},{"name":"normText","kind":"function","exported":false,"isDefault":false,"async":false,"line":47,"sig":"function normText(s: string): string","params":[{"name":"s","type":"string","optional":false,"rest":false,"def":""}],"returns":"string","generics":"","doc":["I keep this the same normalization as the database function nlq.norm()."],"paramDocs":{},"returnDoc":"","id":"34eb58caa5-normText","usedBy":[]},{"name":"meaningfulWords","kind":"function","exported":false,"isDefault":false,"async":false,"line":51,"sig":"function meaningfulWords(s: string): string[]","params":[{"name":"s","type":"string","optional":false,"rest":false,"def":""}],"returns":"string[]","generics":"","doc":[],"paramDocs":{},"returnDoc":"","id":"34eb58caa5-meaningfulWords","usedBy":[]},{"name":"selectRelevantDepartments","kind":"function","exported":true,"isDefault":false,"async":false,"line":61,"sig":"export function selectRelevantDepartments(question: string, all: DepartmentRow[], max = 25): DepartmentRow[]","params":[{"name":"question","type":"string","optional":false,"rest":false,"def":""},{"name":"all","type":"DepartmentRow[]","optional":false,"rest":false,"def":""},{"name":"max","type":"","optional":true,"rest":false,"def":"25"}],"returns":"DepartmentRow[]","generics":"","doc":["The full department list (~300 rows) is about half of a prompt and the language model's per-minute token allowance is limited, so I show only the departments that look relevant to THIS question. Relevance is a plain word overlap between the question and the department name (plus the known short forms, e.g. \"etl\" brings in ELECTRICAL TECHNICAL LAB). Nothing is lost for correctness: a department not shown is still matched by name inside the SQL (nlq.norm(name) LIKE ...), and the prompt says so."],"paramDocs":{},"returnDoc":"","id":"34eb58caa5-selectRelevantDepartments","usedBy":["src/lib/nl2sql/eval/selftest.ts","src/lib/nl2sql/prompt.ts"]},{"name":"NO_AUTO_FAMILY","kind":"constant","exported":false,"line":88,"sig":"const NO_AUTO_FAMILY = new Set([\"ed\"])","type":"","doc":["Do not let these departments' own names start a family of their own: \"ed\" is also the designation Executive Director."],"members":[],"items":0,"id":"34eb58caa5-NO_AUTO_FAMILY","usedBy":[]},{"name":"departmentFamilies","kind":"function","exported":true,"isDefault":false,"async":false,"line":95,"sig":"export function departmentFamilies(question: string, all: DepartmentRow[]): { name: string; rows: DepartmentRow[] }[]","params":[{"name":"question","type":"string","optional":false,"rest":false,"def":""},{"name":"all","type":"DepartmentRow[]","optional":false,"rest":false,"def":""}],"returns":"{ name: string; rows: DepartmentRow[] }[]","generics":"","doc":["I return the departments a question names, each with ALL its rows in the live list, because the people sit in the section rows:","1. the groups written in departmentAliases.ts: nicknames and groupings that the names cannot tell (cocc, W&A, hydraulic lab, main hospital ...);","2. every other department named by its OWN name (the part before the bracket): all the rows that start with it (ACVS and ACVS - OFFICE, L & D with L & D IND and L & D OFFICE ...)."],"paramDocs":{},"returnDoc":"","id":"34eb58caa5-departmentFamilies","usedBy":["src/lib/nl2sql/familyCheck.ts","src/lib/nl2sql/prompt.ts"]},{"name":"formatFamilies","kind":"function","exported":true,"isDefault":false,"async":false,"line":143,"sig":"export function formatFamilies(families: { name: string; rows: DepartmentRow[] }[]): string","params":[{"name":"families","type":"{ name: string; rows: DepartmentRow[] }[]","optional":false,"rest":false,"def":""}],"returns":"string","generics":"","doc":["What the model is told about them; the text is empty when the question names none, so the prompt does not grow."],"paramDocs":{},"returnDoc":"","id":"34eb58caa5-formatFamilies","usedBy":["src/lib/nl2sql/prompt.ts"]},{"name":"formatDepartments","kind":"function","exported":true,"isDefault":false,"async":false,"line":154,"sig":"export function formatDepartments(shown: DepartmentRow[], totalCount: number): string","params":[{"name":"shown","type":"DepartmentRow[]","optional":false,"rest":false,"def":""},{"name":"totalCount","type":"number","optional":false,"rest":false,"def":""}],"returns":"string","generics":"","doc":[],"paramDocs":{},"returnDoc":"","id":"34eb58caa5-formatDepartments","usedBy":["src/lib/nl2sql/prompt.ts"]}],"imports":[{"file":"src/lib/nl2sql/aliasHints.ts","names":["DEPARTMENT_FAMILIES","DEPARTMENT_SHORT_FORMS","DEPARTMENT_WORD_ABBREVIATIONS","DESIGNATION_SHORT_FORMS","MULTI_ROW_DEPARTMENTS"],"lazy":false},{"file":"src/lib/nl2sql/executor.ts","names":["runReadOnly"],"lazy":false},{"file":"src/lib/nl2sql/types.ts","names":["SqlClient"],"lazy":false}],"importedBy":["src/lib/nl2sql/eval/selftest.ts","src/lib/nl2sql/familyCheck.ts","src/lib/nl2sql/namedRows.ts","src/lib/nl2sql/pipeline.ts","src/lib/nl2sql/prompt.ts"],"external":[],"reexports":[],"tests":[],"behaviours":[]}