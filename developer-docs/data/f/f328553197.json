{"id":"src/lib/live/memo.ts","pkg":"src/lib/live","kind":"module","lines":49,"commentLines":9,"header":["A small memory for the live routes. Each answer is kept for a while, so that many people opening the same card in a minute cost the other site one request. When the other site fails, I return the LAST GOOD answer with `stale: true` and its own time, so that the card can say \"as of 3:10 pm, the source is not answering now\" instead of showing nothing, or showing an old number as new. On a serverless host the memory lives only as long as the running instance: that is fine, because it is a courtesy, not a store. Nothing about any user is kept."],"symbols":[{"name":"Entry","kind":"interface","exported":false,"line":7,"generics":"","extends":"","doc":[],"members":[{"kind":"field","name":"at","line":8,"type":"number","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"value","line":9,"type":"unknown","optional":false,"readonly":false,"doc":[]}],"id":"f328553197-Entry","usedBy":[]},{"name":"store","kind":"constant","exported":false,"line":11,"sig":"const store = new Map<string, Entry>()","type":"","doc":[],"members":[],"items":0,"id":"f328553197-store","usedBy":[]},{"name":"Memoised","kind":"interface","exported":true,"line":13,"generics":"T","extends":"","doc":[],"members":[{"kind":"field","name":"value","line":14,"type":"T","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"at","line":16,"type":"number","optional":false,"readonly":false,"doc":["When the value was fetched (ms since the epoch)."]},{"kind":"field","name":"stale","line":18,"type":"boolean","optional":false,"readonly":false,"doc":["True when the other site failed and this is the last good answer."]}],"id":"f328553197-Memoised","usedBy":[]},{"name":"memo","kind":"function","exported":true,"isDefault":false,"async":true,"line":21,"sig":"export async function memo<T>(key: string, ttlMs: number, load: () => Promise<T>, now: () => number = Date.now): Promise<Memoised<T>>","para