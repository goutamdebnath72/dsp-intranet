{"id":"src/lib/ingestion/consensusPatch.ts","pkg":"src/lib/ingestion","kind":"module","lines":225,"commentLines":21,"header":["Consensus patching of a stored page text. The stored text of a page (read by the pipeline's OCR) is compared, word by word, with the readings of two OTHER independent readers of the same page image (Gemini Pro and Gemini Flash). I replace a word of the stored text ONLY when BOTH other readers propose the same replacement for the same place, and only for a token that carries a digit (a number, date, amount, phone, id or clause number): a word the readers spell differently is reported, never changed (a model may silently correct a typo that is really in the original, and the original must stay as printed). These are pure functions with no I/O, so every rule is testable (consensusPatch.selftest.ts)."],"symbols":[{"name":"Tok","kind":"interface","exported":true,"line":9,"generics":"","extends":"","doc":[],"members":[{"kind":"field","name":"raw","line":10,"type":"string","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"pre","line":11,"type":"string","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"core","line":12,"type":"string","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"suf","line":13,"type":"string","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"start","line":14,"type":"number","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"end","line":15,"type":"number","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"norm","line":16,"type":"string","optional":false,"readonly":false,"doc":[]},{"kind":"field","name":"content","line":17,"type":"boolean","optional":false,"readonly":false,"doc":[]}],"id":"076374a97a-Tok","usedBy":[]},{"name":"PRE","kind":"constant","exported":false,"line":20,"sig":"const PRE = /^[\\s\"“”‘’'(\\[{<*_|]+/u","type":"","doc":[],"members":[],"items":0,"id":"076374a97a-PRE","usedBy":[]},{"name":"SUF","kind":"constan