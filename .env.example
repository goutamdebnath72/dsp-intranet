# Copy this file to .env.local and fill in the values. Never commit .env.local (it is ignored by git).
# On Vercel, set the same names under Project > Settings > Environment Variables.

# --- Database (Postgres, e.g. Supabase) ---
DATABASE_URL=
DIRECT_DATABASE_URL=
# optional: a separate read-only login for the question answering (see src/lib/nl2sql/sql/03_optional_dedicated_login_role.sql)
NL2SQL_DATABASE_URL=

# --- Login (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# ticket numbers (comma separated) that have super-admin rights
SUPERADMIN_TICKETS=

# --- Storage for the circulars' page images (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- AI ---
# Gemini does everything: questions to the employee/department engine, the router, Executive Deep Synthesis, embeddings,
# the page reader. This is the only key you need. (Use a PAID tier key: the free tier's limits are too low.)
GEMINI_API_KEY=
# optional model settings (the defaults are in src/lib/ai/geminiChat.ts)
# fast model for questions and routing (default gemini-3.8-flash, then gemini-flash-latest)
GEMINI_CHAT_MODEL=
# model for Executive Deep Synthesis (default gemini-3.1-pro-preview, then gemini-pro-latest, gemini-3.8-flash)
GEMINI_SYNTHESIS_MODEL=
# how much the synthesis model thinks: minimal | low | medium | high (default low; more = slower and dearer)
GEMINI_SYNTHESIS_THINKING=
# page reading (OCR) model used by the upload's second reading and by scripts/reingest-circulars-gemini.ts
GEMINI_VISION_MODEL=
# which provider answers questions: gemini | groq. Empty = gemini whenever GEMINI_API_KEY exists.
LLM_PROVIDER=
# OPTIONAL and no longer needed: only used when LLM_PROVIDER=groq, or when there is no Gemini key at all
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_MODELS=
GROQ_REASONING_EFFORT=

# --- Switches ---
NL2SQL_OMNIBAR_ENABLED=
NL2SQL_LAB_ENABLED=

# Front-path gate (step 24a): skip the slow model call for questions that cannot be employee questions, then ask the
# model anyway if circular search finds nothing. OFF unless this is exactly: true
FRONT_PATH_SKIP_MODEL=

# Synthesis on the Enter key (step 27a, ON by default since step 41a): a question that needs several circulars built into one answer
# (compare, correlate, what is hidden, what changed ...) starts the Executive Deep Synthesis by itself for a logged-in executive. There
# is no button. Leave this empty for ON; set exactly false (or 0, off, no) to turn it off. NEXT_PUBLIC_ because the browser reads it:
# restart `npm run dev` after changing it, and redeploy on Vercel.
NEXT_PUBLIC_FRONT_PATH_AUTO_EDS=

# Answer first (step 29a): when the search finds documents, write the answer they prove ABOVE them, with the source and the exact words
# (checked word for word by the program; nothing is shown if the text does not prove it). Uses about 2,000 to 3,000 model tokens per question.
# OFF unless this is exactly: true. NEXT_PUBLIC_ because the browser reads it: restart `npm run dev` after changing it.
NEXT_PUBLIC_FRONT_PATH_ANSWER_FIRST=
